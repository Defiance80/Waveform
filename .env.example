# ============================================================================
# SLAPBOX ENVIRONMENT
# Copy to .env.local and fill in. .env.local is gitignored -- never commit keys.
# ============================================================================

# ── Supabase (required) ─────────────────────────────────────────────────────
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypasses row level security -- never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Site URL (required in production) ───────────────────────────────────────
# Used for Stripe redirects and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (optional -- trials and gameplay work without it) ────────────────
# Nothing is charged until these are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Anthropic (optional -- powers ContentLab caption generation) ────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Social platform OAuth (optional -- artist console publishing) ───────────
# See docs/SOCIAL-SETUP.md for how to obtain each of these.
X_CLIENT_ID=
X_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
